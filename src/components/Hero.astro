---
import SphereScene from './three/SphereScene';
import { site } from '../data/site';
import { anchor } from '../lib/url';

const chars = [...site.name];
---

<section class="hero" id="top">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__stage" aria-hidden="true">
    <SphereScene client:only="react" />
  </div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="eyebrow" data-hero-anim style="--d: 0.05s">Portfolio — 2026</p>

      <h1 class="hero__title" aria-label={site.name} data-hero-anim style="--d: 0.12s">
        {chars.map((char, i) => (
          <span class="hero__line" aria-hidden="true">
            <span class="hero__char" style={`--i: ${i}`}>{char}</span>
          </span>
        ))}
      </h1>

      <p class="hero__en mono" data-hero-anim style="--d: 0.22s">
        {site.nameEn} — Developer &amp; Security Researcher
      </p>

      <p class="hero__statement" data-hero-anim style="--d: 0.3s">
        {site.headline[0]}
        <br />
        {site.headline[1]}
      </p>

      <p class="hero__intro muted" data-hero-anim style="--d: 0.38s">{site.intro}</p>

      <div class="hero__actions" data-hero-anim style="--d: 0.46s">
        <a class="btn btn--solid" href={anchor('#work')}>
          看看作品
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" />
          </svg>
        </a>
        <a class="btn" href={`mailto:${site.email}`}>聊聊合作</a>
      </div>
    </div>

    <div class="hero__meta">
      <a class="hero__scroll mono" href={anchor('#work')} data-hero-anim style="--d: 0.6s">
        <span class="hero__scroll-line" aria-hidden="true"></span>
        <span>SCROLL TO EXPLORE</span>
      </a>

      <ul class="hero__facts mono" data-hero-anim style="--d: 0.66s">
        {site.facts.map((fact) => (
          <li>
            <span>{fact.k}</span>
            <strong>{fact.v}</strong>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: stretch;
    padding-top: clamp(6.5rem, 12vh, 9rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4rem;
    padding-bottom: 2rem;
    position: relative;
    z-index: 2;
  }

  .hero__glow {
    position: absolute;
    top: 4%;
    right: 2%;
    width: min(72vw, 900px);
    aspect-ratio: 1;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(201, 255, 61, 0.14) 0%,
      rgba(201, 255, 61, 0.05) 32%,
      transparent 66%
    );
    filter: blur(10px);
    z-index: 0;
    pointer-events: none;
  }

  .hero__stage {
    position: absolute;
    top: 50%;
    right: -1vw;
    width: min(58vw, 730px);
    aspect-ratio: 1;
    translate: 0 -52%;
    z-index: 1;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(circle at 55% 50%, #000 55%, transparent 78%);
    mask-image: radial-gradient(circle at 55% 50%, #000 55%, transparent 78%);
  }

  .hero__copy {
    max-width: 44rem;
  }

  .hero__title {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(4.6rem, 13.5vw, 12rem);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.055em;
    display: flex;
    overflow: hidden;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-right: 0.02em;
  }

  .hero__char {
    display: inline-block;
    transform: translateY(110%);
  }

  html.js .hero__char {
    animation: char-rise 1.05s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(0.18s + var(--i) * 0.07s);
  }

  @keyframes char-rise {
    to {
      transform: translateY(0);
    }
  }

  .hero__en {
    margin-top: 1.1rem;
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .hero__statement {
    margin-top: clamp(1.6rem, 3vh, 2.6rem);
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .hero__intro {
    margin-top: 1.2rem;
    max-width: 32rem;
    font-size: clamp(0.92rem, 1.15vw, 1rem);
    line-height: 1.75;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.88rem 1.35rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.86rem;
    letter-spacing: 0.01em;
    transition:
      background 0.28s ease,
      color 0.28s ease,
      border-color 0.28s ease,
      transform 0.28s ease;
  }

  .btn:hover {
    border-color: rgba(241, 241, 234, 0.35);
    transform: translateY(-1px);
  }

  .btn--solid {
    background: var(--color-acid);
    border-color: var(--color-acid);
    color: #050607;
    font-weight: 500;
  }

  .btn--solid:hover {
    background: #dbff7a;
    border-color: #dbff7a;
  }

  .btn svg {
    transition: transform 0.28s ease;
  }

  .btn--solid:hover svg {
    transform: translateX(3px);
  }

  .hero__meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--color-mute);
  }

  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 42px;
    background: rgba(241, 241, 234, 0.16);
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-acid);
    transform: translateY(-100%);
    animation: scroll-line 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes scroll-line {
    0% {
      transform: translateY(-100%);
    }
    55%,
    100% {
      transform: translateY(100%);
    }
  }

  .hero__facts {
    display: flex;
    gap: clamp(1.2rem, 3vw, 2.8rem);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__facts li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .hero__facts span {
    color: var(--color-mute);
  }

  .hero__facts strong {
    font-weight: 400;
    color: var(--color-paper);
  }

  html.js [data-hero-anim] {
    animation: fade-rise 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes fade-rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  /* WebGL 不可用时的纯 CSS 线框球 */
  .sphere-fallback {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }

  .sphere-fallback span {
    position: absolute;
    border: 1px solid rgba(201, 255, 61, 0.22);
    border-radius: 50%;
  }

  .sphere-fallback span:nth-child(1) {
    width: 58%;
    height: 58%;
  }

  .sphere-fallback span:nth-child(2) {
    width: 58%;
    height: 22%;
  }

  .sphere-fallback span:nth-child(3) {
    width: 22%;
    height: 58%;
  }

  @media (max-width: 900px) {
    .hero__stage {
      top: 34%;
      right: -22vw;
      width: min(96vw, 560px);
      opacity: 0.55;
    }

    .hero__glow {
      right: -30%;
      top: 6%;
      width: 120vw;
    }

    .hero__facts li:nth-child(3) {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero__title {
      font-size: clamp(4rem, 22vw, 7rem);
    }

    .hero__en {
      font-size: 0.58rem;
      letter-spacing: 0.12em;
    }

    .hero__stage {
      top: 30%;
      right: -30vw;
      width: 118vw;
      opacity: 0.42;
    }

    .hero__meta {
      align-items: flex-start;
      flex-direction: column-reverse;
      gap: 1.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .hero__char,
    html.js [data-hero-anim] {
      animation: none;
      transform: none;
      opacity: 1;
    }

    .hero__scroll-line::after {
      animation: none;
      transform: translateY(0);
    }
  }
</style>
