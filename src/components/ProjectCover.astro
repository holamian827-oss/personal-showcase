---
interface Props {
  variant: 'graph' | 'iris' | 'sphere';
  title: string;
}

const { variant, title } = Astro.props;
---

<div class="cover">
  <svg viewBox="0 0 160 100" fill="none" role="img" aria-label={`${title} 封面`}>
    <title>{title} 封面</title>
    <defs>
      <radialGradient id={`glow-${variant}`} cx="50%" cy="50%" r="55%">
        <stop offset="0%" stop-color="#c9ff3d" stop-opacity="0.14" />
        <stop offset="100%" stop-color="#c9ff3d" stop-opacity="0" />
      </radialGradient>
      <linearGradient id={`scan-${variant}`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#c9ff3d" stop-opacity="0" />
        <stop offset="50%" stop-color="#c9ff3d" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#c9ff3d" stop-opacity="0" />
      </linearGradient>
    </defs>

    <rect width="160" height="100" fill="#070808" />
    <circle cx="80" cy="50" r="64" fill={`url(#glow-${variant})`} />

    <g stroke="#f1f1ea" stroke-opacity="0.055">
      <path d="M0 20H160M0 40H160M0 60H160M0 80H160" />
      <path d="M20 0V100M40 0V100M60 0V100M80 0V100M100 0V100M120 0V100M140 0V100" />
    </g>

    {variant === 'graph' && (
      <g>
        <g stroke="#f1f1ea" stroke-opacity="0.42" stroke-width="0.8">
          <path d="M24 70 46 38 78 58 98 26 124 44 138 74" />
          <path d="M46 38 62 80 78 58" />
          <path d="M78 58 98 26" />
          <path d="M98 26 124 44 78 58" />
        </g>
        <g fill="#f1f1ea" fill-opacity="0.7">
          <circle cx="24" cy="70" r="2" />
          <circle cx="46" cy="38" r="2.2" />
          <circle cx="78" cy="58" r="1.8" />
          <circle cx="124" cy="44" r="2" />
          <circle cx="62" cy="80" r="1.6" />
          <circle cx="138" cy="74" r="1.8" />
        </g>
        <circle cx="98" cy="26" r="3.4" fill="#c9ff3d" />
        <circle cx="98" cy="26" r="8" stroke="#c9ff3d" stroke-opacity="0.35" />
        <rect x="104" y="0" width="1" height="100" fill={`url(#scan-${variant})`} />
        <path d="M112 78h20M112 84h12M112 90h16" stroke="#c9ff3d" stroke-opacity="0.5" stroke-width="0.8" />
      </g>
    )}

    {variant === 'iris' && (
      <g>
        <g stroke="#f1f1ea" stroke-opacity="0.4" stroke-width="0.8">
          <circle cx="80" cy="50" r="34" />
          <circle cx="80" cy="50" r="25" />
          <circle cx="80" cy="50" r="16" />
          <circle cx="80" cy="50" r="7" />
        </g>
        <g stroke="#c9ff3d" stroke-opacity="0.55" stroke-width="0.8">
          {Array.from({ length: 24 }).map((_, i) => {
            const a = (i / 24) * Math.PI * 2;
            const x1 = 80 + Math.cos(a) * 17;
            const y1 = 50 + Math.sin(a) * 17;
            const x2 = 80 + Math.cos(a) * 31;
            const y2 = 50 + Math.sin(a) * 31;
            return <path d={`M${x1.toFixed(1)} ${y1.toFixed(1)}L${x2.toFixed(1)} ${y2.toFixed(1)}`} />;
          })}
        </g>
        <circle cx="80" cy="50" r="3.2" fill="#c9ff3d" />
        <rect x="0" y="49" width="160" height="1" fill={`url(#scan-${variant})`} />
        <path d="M16 18h14M16 24h8" stroke="#f1f1ea" stroke-opacity="0.4" stroke-width="0.8" />
        <path d="M130 82h14M136 76h8" stroke="#c9ff3d" stroke-opacity="0.45" stroke-width="0.8" />
      </g>
    )}

    {variant === 'sphere' && (
      <g>
        <g stroke="#f1f1ea" stroke-opacity="0.42" stroke-width="0.8">
          <circle cx="80" cy="50" r="36" />
          <ellipse cx="80" cy="50" rx="36" ry="12" />
          <ellipse cx="80" cy="50" rx="36" ry="24" />
          <ellipse cx="80" cy="50" rx="12" ry="36" />
          <ellipse cx="80" cy="50" rx="24" ry="36" />
          <ellipse cx="80" cy="50" rx="36" ry="14" transform="rotate(42 80 50)" stroke-opacity="0.25" />
          <ellipse cx="80" cy="50" rx="36" ry="14" transform="rotate(-42 80 50)" stroke-opacity="0.25" />
        </g>
        <g fill="#c9ff3d">
          <circle cx="110" cy="30" r="1.8" />
          <circle cx="50" cy="66" r="1.5" />
          <circle cx="92" cy="78" r="1.3" />
          <circle cx="58" cy="26" r="1.2" />
        </g>
        <circle cx="116" cy="50" r="2.4" fill="#c9ff3d" />
        <rect x="0" y="49" width="160" height="1" fill={`url(#scan-${variant})`} />
      </g>
    )}

    <rect width="159" height="99" x="0.5" y="0.5" rx="9" stroke="#f1f1ea" stroke-opacity="0.06" />
  </svg>
</div>

<style>
  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: #070808;
    transition:
      border-color 0.35s ease,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cover svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(.work__row:hover) .cover {
    border-color: rgba(201, 255, 61, 0.35);
    transform: scale(1.03);
  }
</style>
