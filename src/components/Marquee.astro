---
const words = ['BUILD', 'BREAK', 'SHIP', 'REPEAT', 'WRITE', 'HUNT', 'REFINE', 'REPEAT'];
const row = [...words, ...words];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {row.map((word) => (
      <span class="marquee__word">
        {word}
        <i>✳</i>
      </span>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--color-line);
    padding-block: 1.1rem;
    background: rgba(241, 241, 234, 0.015);
    user-select: none;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }

  .marquee__word {
    display: inline-flex;
    align-items: center;
    gap: 1.6rem;
    padding-right: 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(241, 241, 234, 0.5);
    white-space: nowrap;
  }

  .marquee__word:nth-child(4n + 1) {
    color: var(--color-acid);
  }

  .marquee__word i {
    font-style: normal;
    font-size: 0.7em;
    color: var(--color-acid);
    opacity: 0.7;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
